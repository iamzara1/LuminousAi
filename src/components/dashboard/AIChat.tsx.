"use client";

import { useState } from "react";
import { Send } from "lucide-react";

export default function AIChat() {
  const [message, setMessage] = useState("");
  const [response, setResponse] = useState(
    "Ask me about crypto markets, tokens, or blockchain."
  );

  function handleSend() {
    if (!message.trim()) return;

    setResponse(
      `Luminous AI is analyzing: "${message}"...`
    );

    setMessage("");
  }

  return (
    <section className="rounded-3xl border border-white/10 bg-[#0D0D14] p-4 sm:p-8">
      <div className="flex items-center justify-between">
        <h2 className="text-xl sm:text-2xl font-bold text-white">
          🤖 Luminous AI
        </h2>

        <span className="rounded-full bg-violet-500/10 px-3 py-1 text-xs text-violet-400">
          Online
        </span>
      </div>

      <div className="mt-6 space-y-4">
        <div className="rounded-2xl bg-[#151520] p-4 text-gray-300">
          Analyse Ethereum and compare it with Solana.
        </div>

        <div className="rounded-2xl border border-violet-500/20 bg-violet-500/10 p-4 text-gray-200">
          {response}
        </div>
      </div>

      <div className="mt-6 flex gap-2">
        <input
          value={message}
          onChange={(e) => setMessage(e.target.value)}
          placeholder="Ask LuminousAI anything..."
          className="min-w-0 flex-1 rounded-xl border border-white/10 bg-[#101018] px-4 py-3 text-white outline-none"
        />

        <button
          onClick={handleSend}
          className="rounded-xl bg-violet-600 p-3 hover:bg-violet-500"
        >
          <Send size={18} />
        </button>
      </div>
    </section>
  );
}
